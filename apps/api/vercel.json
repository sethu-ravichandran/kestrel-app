{
  "functions": { "api/index.js": { "includeFiles": "data/**" } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__path=api/:path*" },
    { "source": "/scim/:path*", "destination": "/api?__path=scim/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
